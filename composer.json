{
  "name": "websonette/web-application",
  "description": "Framework-independent page context, breadcrumbs, and shared web application state.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "Websonette\\WebApplication\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Websonette\\WebApplication\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse",
    "tests": "phpunit",
    "test": [
      "@composer validate --strict",
      "@tests",
      "@analyse"
    ]
  },
  "config": {
    "sort-packages": true
  }
}