{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://websonette.github.io/contracts/breadcrumbs.v1.schema.json",
  "title": "Websonette Breadcrumbs v1",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "url", "icon", "description"],
    "properties": {
      "title": { "type": "string" },
      "url": { "type": "string", "format": "uri-reference" },
      "icon": { "type": ["string", "null"] },
      "description": { "type": ["string", "null"] }
    }
  }
}
