{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://websonette.github.io/scaffold/project-profile.v1.schema.json",
  "title": "Websonette adapter project profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "repository", "extends", "references"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "extends": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "contractVersion"],
      "properties": {
        "repository": { "const": "Websonette/web-application" },
        "contractVersion": { "const": 1 }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "composer": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "npm": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.md$" }
    },
    "rule": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.mdc$" }
  }
}
